rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function admin() { return request.auth != null && request.auth.uid == "GG2xiZf0wngznA1LaeeZQCfEhWW2"; }
function valid() { let d=request.resource.data; return d.keys().hasOnly(['type','region','event','title','date','body','source','image','published','updatedAt']) && d.keys().hasAll(['type','region','event','title','date','body','source','image','published','updatedAt']) && d.type in ['news','live','tournaments','teams','mercato','analysis'] && d.region in ['MENA','Global'] && d.title is string && d.title.size() > 0 && d.title.size() <= 160 && d.body is string && d.body.size() <= 20000 && d.published is bool && d.date is string && d.event is string && d.image is string && d.source is string && d.source.matches('https://.*') && (d.image == '' || d.image.matches('https://.*')) && d.updatedAt == request.time; }
match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
match /content/{id} { allow read: if resource.data.published == true || admin(); allow create, update: if admin() && valid(); allow delete: if admin(); }
function tournament() { let d=request.resource.data; return d.keys().hasOnly(['name','region','game','status','startDate','endDate','teamsCount','prizePool','currency','logo','source','published']) && d.name is string && d.name.size()>0 && d.region in ['MENA','Global'] && d.game=='Free Fire' && d.status in ['upcoming','live','completed','cancelled'] && d.startDate is string && d.endDate is string && d.teamsCount is int && d.teamsCount>=0 && d.prizePool is number && d.prizePool>=0 && d.currency is string && d.logo is string && (d.logo=='' || d.logo.matches('https://.*')) && d.source is string && d.source.matches('https://.*') && d.published is bool; }
match /tournaments/{id} { allow read: if admin() || resource.data.published == true; allow create,update: if admin() && tournament(); allow delete: if admin(); }
match /{collection}/{id} { allow read: if collection in ['matches','standings','teams','players','transfers'] && (admin() || resource.data.published == true); allow create,update: if collection in ['matches','standings','teams','players','transfers'] && admin() && request.resource.data.published is bool; allow delete: if collection in ['matches','standings','teams','players','transfers'] && admin(); }
match /{document=**} { allow read, write: if false; }
} }
